#include "keys_us_international.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define base        0
#define symbols     1
#define numbers     2
#define system      3
#define umlaute     4

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <150>;
        };
    };

    combos {
        compatible = "zmk,combos";

        caps-word {
            bindings = <&caps_word>;
            key-positions = <17 12>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "base";
            bindings = <
           &kp Q       &kp W       &kp E             &kp R               &kp T           &kp Y            &kp U               &kp I             &kp O           &kp P
           &hm LGUI A  &hm LALT S  &hm LEFT_SHIFT D  &hm LEFT_CONTROL F  &kp G           &kp H            &hm LEFT_CONTROL J  &hm LEFT_SHIFT K  &hm LEFT_ALT L  &hm LEFT_WIN SEMICOLON
&lt 3 TAB  &kp Z       &kp X       &kp C             &kp V               &kp B           &kp N            &kp M               &kp COMMA         &kp DOT         &kp SLASH               &kp APOSTROPHE
                                   &none             &lt 1 SPACE         &lt 3 ESCAPE    &lt 4 BACKSPACE  &lt 2 ENTER         &none
            >;
        };

        symbols {
            display-name = "symbols";
            bindings = <
               &none            &kp AT_SIGN     &kp HASH          &kp DOLLAR            &kp PERCENT     &kp CARET        &kp AMPERSAND          &kp ASTERISK       &kp BACKSLASH    &none
               &kp EXCLAMATION  &kp LEFT_BRACE  &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp GRAVE       &kp MINUS        &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp RIGHT_BRACE  &kp EQUAL
&kp LESS_THAN  &none            &none           &none             &none                 &none           &none            &none                  &kp COMMA          &kp PERIOD       &kp SLASH  &kp GREATER_THAN
                                                &none             &lt 1 SPACE           &lt 3 ESCAPE    &lt 4 BACKSPACE  &lt 2 ENTER            &none
            >;
        };

        numbers {
            display-name = "numbers";
            bindings = <
       &kp F1                 &kp F2                 &kp F3                   &kp F4                     &kp F5             &kp F6           &kp F7                     &kp F8             &kp F9                 &kp F10
       &hm LEFT_WIN NUMBER_1  &hm LEFT_ALT NUMBER_2  &hm LEFT_SHIFT NUMBER_3  &hm LEFT_CONTROL NUMBER_4  &kp NUMBER_5       &kp NUMBER_6     &hm LEFT_CONTROL NUMBER_7  &hm LEFT_SHIFT N8  &hm LEFT_ALT NUMBER_9  &hm LEFT_WIN NUMBER_0
&none  &kp F11                &none                  &none                    &none                      &none              &kp UNDER        &kp EQUAL                  &kp COMMA          &kp PERIOD             &kp F12                &none
                                                     &none                    &lt 1 SPACE                &lt 3 BACKSPACE    &lt 4 BACKSPACE  &lt 2 ENTER                &none
            >;
        };

        system {
            display-name = "system";
            bindings = <
       &none  &kp C_VOLUME_DOWN  &kp C_MUTE        &kp C_VOLUME_UP  &none           &none           &none           &none         &none            &none
       &none  &kp C_PREVIOUS     &kp C_PLAY_PAUSE  &kp C_NEXT       &none           &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &none
&none  &none  &bt BT_PRV         &bt BT_CLR        &bt BT_NXT       &none           &none           &none           &none         &none            &none  &none
                                 &none             &lt 1 SPACE      &lt 3 ESCAPE    &kp DELETE      &lt 2 ENTER     &none
            >;
        };

        umlaute {
            bindings = <
       &none            &none          &kp EN_SECTION  &kp EN_EURO  &none           &none            &kp EN_U_UMLAUT  &none           &kp EN_O_UMLAUT  &none
       &kp EN_A_UMLAUT  &kp EN_ESZETT  &kp LEFT_SHIFT  &none        &none           &none            &none            &kp LEFT_SHIFT  &none            &none
&none  &none            &none          &none           &none        &none           &none            &none            &none           &none            &none  &none
                                       &none           &lt 1 SPACE  &lt 3 ESCAPE    &lt 4 BACKSPACE  &lt 2 ENTER      &none
            >;
        };
    };
};
